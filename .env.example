# ─────────────────────────────────────────────
# .env.example  —  Template cấu hình
# Sao chép thành .env rồi điền giá trị thật:
#   cp .env.example .env
# ─────────────────────────────────────────────

# ── UI ────────────────────────────────────────
DEMO_MODE=true
BACKEND_URL=http://localhost:8000
API_TIMEOUT=600
API_INGEST_TIMEOUT=300

# ── LLM (Ollama) ──────────────────────────────
# Đảm bảo Ollama đang chạy: ollama serve
# Pull model trước: ollama pull qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen2.5:14b
LLM_TEMPERATURE=0.05
LLM_MAX_TOKENS=512
LLM_COMPARE_MAX_CHARS=1000
LLM_KEEP_ALIVE=30m
LLM_TIMEOUT=120

# ── Embedding ─────────────────────────────────
# Model sẽ tự download lần đầu chạy (~600MB)
# cuda:0 = RTX 3050; để trống = tự phát hiện GPU
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda:0
EMBEDDING_FP16=true
EMBEDDING_BATCH=12
EMBEDDING_MAXLEN=512

# ── ChromaDB ──────────────────────────────────
CHROMA_METRIC=cosine
CHROMA_UPSERT_BATCH=256
ANONYMIZED_TELEMETRY=False

# ── Chunking ──────────────────────────────────
CHUNK_MAX=800
CHUNK_OVL=100
CHUNK_MIN=30

# ── Comparison ────────────────────────────────
SIM_THRESHOLD=0.85
CITATION_MIN_LEN=20
MAX_CHANGES=50
# Comparator: bỏ qua LLM khi sim/ratio đủ cao (giảm 30-40 call → ~3-8)
COMPARATOR_FAST_SIM=0.97
COMPARATOR_FAST_RATIO=0.97
COMPARATOR_MEDIUM_SIM=0.90
COMPARATOR_PREP_WORKERS=4
COMPARATOR_LLM_SIM_FLOOR=0.90
COMPARATOR_LLM_RATIO_FLOOR=0.80
LLM_BATCH_SIZE=5

# ── FastAPI ───────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
MAX_FILE_MB=20
